{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "CPU, память, диски и сеть сервера UniMeow. Метрики собирает Node Exporter. Для скоростей нужны минимум два сбора Prometheus.",
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "1 — Prometheus успешно собрал метрики; 0 — ошибка сбора. Отсутствие данных не заменяется нулём.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "unit": "short",
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "up{job=\"node-exporter\",instance=\"host.docker.internal:9100\"}",
          "legendFormat": "UniMeow",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Node Exporter",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Время с загрузки Linux по последнему сбору метрик. Перезапуск приложения этот показатель не сбрасывает.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "dtdurations"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "node_time_seconds{job=\"node-exporter\",instance=\"host.docker.internal:9100\"} - node_boot_time_seconds{job=\"node-exporter\",instance=\"host.docker.internal:9100\"}",
          "legendFormat": "UniMeow",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Server Uptime",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Средняя доля времени вне idle по всем логическим ядрам. Включает ожидание I/O; это показатель всего Linux-хоста.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node-exporter\",instance=\"host.docker.internal:9100\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "UniMeow",
          "refId": "A"
        }
      ],
      "title": "CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Доля памяти, недоступной для новых приложений: 1 − MemAvailable / MemTotal. Освобождаемый файловый кэш учитывается как доступная память.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node-exporter\",instance=\"host.docker.internal:9100\"} / node_memory_MemTotal_bytes{job=\"node-exporter\",instance=\"host.docker.internal:9100\"})",
          "legendFormat": "UniMeow",
          "refId": "A"
        }
      ],
      "title": "Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Средняя за минуту нагрузка, делённая на число логических ядер. Учитывает выполняемые задачи и ожидание I/O; значение выше 1 само по себе не означает 100% загрузку CPU.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (instance) (node_load1{job=\"node-exporter\",instance=\"host.docker.internal:9100\"}) / count by (instance) (node_cpu_seconds_total{job=\"node-exporter\",instance=\"host.docker.internal:9100\",mode=\"idle\"})",
          "legendFormat": "UniMeow",
          "refId": "A"
        }
      ],
      "title": "Load per CPU",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Доля занятого или зарезервированного места: 1 − available / size, отдельно по точкам монтирования. Исключены tmpfs, overlay и служебные монтирования.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\",instance=\"host.docker.internal:9100\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|autofs\",mountpoint!~\"/(dev|proc|sys|var/lib/docker)($|/.*)\"} / (node_filesystem_size_bytes{job=\"node-exporter\",instance=\"host.docker.internal:9100\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|autofs\",mountpoint!~\"/(dev|proc|sys|var/lib/docker)($|/.*)\"} > 0))",
          "legendFormat": "{{mountpoint}} ({{device}})",
          "refId": "A"
        }
      ],
      "title": "Filesystem Usage",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Скорость чтения и записи по блочным устройствам; loop, RAM-диски и оптические приводы исключены. Устройства не суммируются: разделы и их диски могут отражать один и тот же I/O.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{job=\"node-exporter\",instance=\"host.docker.internal:9100\",device!~\"loop.*|ram.*|fd.*|sr.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} read",
          "refId": "A"
        },
        {
          "expr": "rate(node_disk_written_bytes_total{job=\"node-exporter\",instance=\"host.docker.internal:9100\",device!~\"loop.*|ram.*|fd.*|sr.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} write",
          "refId": "B"
        }
      ],
      "title": "Disk Read / Write",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Входящий и исходящий трафик по интерфейсам хоста. Loopback и типовые интерфейсы Docker исключены; RX и TX показаны положительными значениями.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{job=\"node-exporter\",instance=\"host.docker.internal:9100\",device!~\"lo|docker.*|br-.*|veth.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} RX",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{job=\"node-exporter\",instance=\"host.docker.internal:9100\",device!~\"lo|docker.*|br-.*|veth.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} TX",
          "refId": "B"
        }
      ],
      "title": "Network Receive / Transmit",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": [
    "unimeow",
    "server",
    "prometheus"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "UniMeow Server",
  "uid": "unimeow-server",
  "version": 1
}
