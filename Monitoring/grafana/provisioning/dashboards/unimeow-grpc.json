{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "gRPC-вызовы, распределение по экземплярам, ошибки и длительность обработки на сервере. Метрики появляются после первого вызова; для скорости нужны минимум два сбора Prometheus.",
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Оценка числа завершённых вызовов за выбранный период по всем выбранным экземплярам. Prometheus учитывает промежутки между сборами, поэтому значение может быть дробным.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(grpc_server_seconds_count{job=~\"${service}\",instance=~\"${instance}\",rpc_method=~\"${method}\"}[$__range]))",
          "legendFormat": "calls",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Calls in Selected Range",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Частота завершённых вызовов по выбранным экземплярам, включая все коды завершения.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(grpc_server_seconds_count{job=~\"${service}\",instance=~\"${instance}\",rpc_method=~\"${method}\"}[$__rate_interval]))",
          "legendFormat": "calls/s",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Calls per Second",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Оценка числа вызовов с кодом, отличным от OK, за выбранный период. Ноль отображается только при наличии метрик вызовов; отсутствие метрик остаётся No data.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(grpc_server_seconds_count{job=~\"${service}\",instance=~\"${instance}\",rpc_method=~\"${method}\",grpc_status_code!=\"OK\"}[$__range])) or (0 * sum(increase(grpc_server_seconds_count{job=~\"${service}\",instance=~\"${instance}\",rpc_method=~\"${method}\"}[$__range])))",
          "legendFormat": "non-OK calls",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Non-OK Calls in Selected Range",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Средняя длительность обработки на сервере, взвешенная по числу вызовов всех выбранных экземпляров и кодов завершения. Без вызовов среднее не определено.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(grpc_server_seconds_sum{job=~\"${service}\",instance=~\"${instance}\",rpc_method=~\"${method}\"}[$__rate_interval])) / (sum(rate(grpc_server_seconds_count{job=~\"${service}\",instance=~\"${instance}\",rpc_method=~\"${method}\"}[$__rate_interval])) > 0)",
          "legendFormat": "average",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Average Call Duration",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Распределение запросов между экземплярами одного сервиса. Разные сервисы не обязаны получать одинаковый трафик.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (job, instance) (rate(grpc_server_seconds_count{job=~\"${service}\",instance=~\"${instance}\",rpc_method=~\"${method}\"}[$__rate_interval]))",
          "legendFormat": "{{job}} / {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Calls per Second by Replica",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Завершённые вызовы по приложению, gRPC-сервису и методу, суммарно по выбранным экземплярам.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (job, rpc_service, rpc_method) (rate(grpc_server_seconds_count{job=~\"${service}\",instance=~\"${instance}\",rpc_method=~\"${method}\"}[$__rate_interval]))",
          "legendFormat": "{{job}} / {{rpc_service}}.{{rpc_method}}",
          "refId": "A"
        }
      ],
      "title": "Calls per Second by Method",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Коды завершения, отличные от OK, включая отмены и превышение срока ожидания. No data может означать отсутствие зарегистрированных ошибок; наличие трафика видно на панелях вызовов.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (job, grpc_status_code) (rate(grpc_server_seconds_count{job=~\"${service}\",instance=~\"${instance}\",rpc_method=~\"${method}\",grpc_status_code!=\"OK\"}[$__rate_interval]))",
          "legendFormat": "{{job}} / {{grpc_status_code}}",
          "refId": "A"
        }
      ],
      "title": "Non-OK Calls per Second by Status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Средняя длительность обработки каждого метода на сервере, взвешенная по числу вызовов выбранных экземпляров. Без вызовов среднее не определено.",
      "fieldConfig": {
        "defaults": {
