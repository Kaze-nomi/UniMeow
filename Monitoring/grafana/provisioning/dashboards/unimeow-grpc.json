          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (job, rpc_service, rpc_method) (rate(grpc_server_seconds_sum{job=~\"${service}\",instance=~\"${instance}\",rpc_method=~\"${method}\"}[$__rate_interval])) / (sum by (job, rpc_service, rpc_method) (rate(grpc_server_seconds_count{job=~\"${service}\",instance=~\"${instance}\",rpc_method=~\"${method}\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{job}} / {{rpc_service}}.{{rpc_method}}",
