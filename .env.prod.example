# Copy privately to /srv/unimeow/config/production.env during initial installation.
# Never commit production.env. Preserve values from the existing installation.
DB_USERNAME=
DB_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
APP_PUBLIC_URL=
APP_MINIO_PUBLIC_URL=
APP_SECURITY_SECURE_COOKIE=true
APP_SECURITY_ALLOWED_ORIGINS=
GRAFANA_USER=
GRAFANA_PASSWORD=
# Deployment records image/volume IDs and internal namespaces automatically.
# They are not settings that the application owner needs to fill in here.
